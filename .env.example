# Provider: gemini or anthropic. Set only the key for your provider.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Leave empty to use the provider default.
LLM_MODEL=
# Optional: comma-separated model IDs available to the SAME provider/project.
# Tried in order after LLM_MODEL. Empty means fallback is disabled.
# Replace the illustrative IDs below with actual model IDs you can access:
# LLM_FALLBACK_MODELS=your-backup-model-id,your-second-backup-model-id
LLM_FALLBACK_MODELS=
# Shared project quota may affect every model. Restart Streamlit after changes.
